{
  "name": "estate-document-templates",
  "version": "1.0.0",
  "description": "Client-side drafting tool for Washington State estate planning documents.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjiwa/estate-document-templates.git"
  },
  "keywords": [],
  "author": "Kamil Jiwa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kjiwa/estate-document-templates/issues"
  },
  "homepage": "https://kjiwa.github.io/estate-document-templates/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
